<!DOCTYPE html>
<html lang="en">
<head>
 <% include ../partials/head %>
</head>
<body>
<% include ../partials/menu %>

<div class="container-fluid bg-3 product-detail">
  <div class="container">
    <div class="row">
      <div class="col-sm-6">
        <div class="product-image-wrap">
          <img src="<%= product.image_path %>" alt="<%= product.name %>">
        </div>
      </div>
      <div class="col-sm-6">
        <% if (product.badge) { %><span class="bundle-tag" style="position:static; display:inline-block; margin-bottom:14px;"><%= product.badge %></span><% } %>
        <h1 class="product-title"><%= product.name %></h1>
        <p class="product-brand"><%= product.brand %> &middot; <%= product.ball_type %></p>

        <% if (product.review_count > 0) { %>
        <div class="bundle-card-rating">
          <span class="star-rating">
            <% for (var s = 1; s <= 5; s++) { %><span class="<%= s <= Math.round(product.avg_rating) ? '' : 'star-empty' %>">&#9733;</span><% } %>
          </span>
          <span class="star-rating-value"><%= Number(product.avg_rating).toFixed(1) %> (<%= product.review_count %> review<%= product.review_count === 1 ? '' : 's' %>)</span>
        </div>
        <% } %>

        <div class="product-price-row">
          <% if (product.compare_at_price) { %><span class="product-price-original">$<%= Number(product.compare_at_price).toFixed(2) %></span><% } %>
          <span class="product-price">$<%= Number(product.price).toFixed(2) %></span>
          <% if (product.compare_at_price) { %>
          <span class="product-discount-badge">Save <%= Math.round((1 - product.price / product.compare_at_price) * 100) %>%</span>
          <% } %>
        </div>

        <p class="product-description"><%= product.description %></p>

        <div class="product-included">
          <strong><%= product.cans %> cans &times; <%= product.balls_per_can %> balls</strong> = <%= product.total_balls %> premium padel balls
        </div>

        <p class="product-stock-note <%= product.stock === 0 ? 'text-danger' : (product.stock <= 5 ? '' : 'text-muted') %>" style="<%= product.stock > 0 && product.stock <= 5 ? 'color: var(--sky-warning); font-weight:600;' : '' %>">
          <% if (product.stock === 0) { %>Out of stock<% } else if (product.stock <= 5) { %>Only <%= product.stock %> left in stock<% } else { %>In stock and ready to ship<% } %>
        </p>

        <form id="product-add-form" class="product-actions-row" data-product-id="<%= product.id %>">
          <div class="qty-selector">
            <button type="button" class="qty-decrease">&minus;</button>
            <input type="number" name="quantity" value="1" min="1" max="<%= product.stock %>">
            <button type="button" class="qty-increase">+</button>
          </div>
          <button type="submit" class="btn-sky btn-sky-yellow add-to-cart-form" <%= product.stock === 0 ? 'disabled' : '' %>>Add to Cart</button>
          <button type="submit" class="btn-sky btn-sky-outline-dark buy-now-form" <%= product.stock === 0 ? 'disabled' : '' %>>Buy Now</button>
        </form>

        <ul class="product-specs">
          <li><span class="spec-label">Durability</span><span class="spec-value"><%= product.durability_rating %></span></li>
          <li><span class="spec-label">Speed</span><span class="spec-value"><%= product.speed_rating %></span></li>
          <li><span class="spec-label">Recommended For</span><span class="spec-value"><%= product.recommended_use %></span></li>
        </ul>
      </div>
    </div>

    <% if (related.length) { %>
    <div class="shop-section-header shop-section-header-spaced">
      <h2>You May Also Like</h2>
    </div>
    <div class="row bundle-row">
      <% related.forEach(function(p) { %>
      <div class="col-sm-4">
        <div class="bundle-card">
          <a href="/shop/<%= p.slug %>"><img class="bundle-card-image" src="<%= p.image_path %>" alt="<%= p.name %>"></a>
          <h3><a href="/shop/<%= p.slug %>" style="color:inherit;"><%= p.name %></a></h3>
          <p class="bundle-unit"><%= p.cans %> cans &middot; <%= p.total_balls %> balls</p>
          <div class="bundle-price">$<%= Number(p.price).toFixed(2) %></div>
          <a href="/shop/<%= p.slug %>" class="btn-sky btn-sky-outline-dark btn-sky-block">View Details</a>
        </div>
      </div>
      <% }); %>
    </div>
    <% } %>

    <div class="reviews-section">
      <h2>Reviews</h2>
      <% if (product.review_count > 0) { %>
      <div class="review-summary">
        <div class="review-summary-score"><%= Number(product.avg_rating).toFixed(1) %></div>
        <div>
          <div class="star-rating" style="font-size:18px;">
            <% for (var rs = 1; rs <= 5; rs++) { %><span class="<%= rs <= Math.round(product.avg_rating) ? '' : 'star-empty' %>">&#9733;</span><% } %>
          </div>
          <div class="star-rating-value"><%= product.review_count %> review<%= product.review_count === 1 ? '' : 's' %></div>
        </div>
      </div>
      <% } %>

      <% if (reviewError) { %><div class="form-error-banner"><%= reviewError %></div><% } %>
      <% if (reviewed) { %><div class="form-success-banner">Thanks for your review!</div><% } %>

      <% if (canReview) { %>
      <div class="review-form">
        <h3>Leave a Review</h3>
        <form class="sky-form" method="POST" action="/shop/<%= product.slug %>/reviews">
          <div class="form-group">
            <label>Rating</label><br>
            <div class="star-input">
              <input type="radio" name="rating" id="star5" value="5"><label for="star5">&#9733;</label>
              <input type="radio" name="rating" id="star4" value="4"><label for="star4">&#9733;</label>
              <input type="radio" name="rating" id="star3" value="3"><label for="star3">&#9733;</label>
              <input type="radio" name="rating" id="star2" value="2"><label for="star2">&#9733;</label>
              <input type="radio" name="rating" id="star1" value="1" checked><label for="star1">&#9733;</label>
            </div>
          </div>
          <div class="form-group">
            <label for="comment">Comment</label>
            <textarea id="comment" name="comment" class="form-control" rows="3" required></textarea>
          </div>
          <button type="submit" class="btn-sky btn-sky-yellow">Submit Review</button>
        </form>
      </div>
      <% } else if (alreadyReviewed) { %>
        <p class="admin-empty-note">You've already reviewed this product &mdash; thanks!</p>
      <% } else if (typeof isSignedIn !== 'undefined' && isSignedIn) { %>
        <p class="admin-empty-note">Only customers who purchased this bundle can leave a review.</p>
      <% } else { %>
        <p class="admin-empty-note"><a href="/login?redirect=<%= encodeURIComponent('/shop/' + product.slug) %>">Sign in</a> after your purchase to leave a review.</p>
      <% } %>

      <% if (reviews.length === 0) { %>
        <p class="admin-empty-note">No reviews yet &mdash; be the first to try this bundle.</p>
      <% } else { %>
        <% reviews.forEach(function(r) { %>
        <div class="review-card">
          <div class="review-card-header">
            <span class="review-author"><%= r.first_name %> <%= r.last_name.charAt(0) %>.</span>
            <span class="review-date"><%= new Date(r.created_at).toLocaleDateString() %></span>
          </div>
          <div class="star-rating">
            <% for (var rr = 1; rr <= 5; rr++) { %><span class="<%= rr <= r.rating ? '' : 'star-empty' %>">&#9733;</span><% } %>
          </div>
          <p class="review-comment"><%= r.comment %></p>
        </div>
        <% }); %>
      <% } %>
    </div>

  </div>
</div>

<% include ../partials/footer %>
</body>
<% include ../partials/script %>
</html>
