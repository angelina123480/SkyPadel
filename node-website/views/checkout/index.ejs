<!DOCTYPE html>
<html lang="en">
<head>
 <% include ../partials/head %>
</head>
<body>
<% include ../partials/menu %>

<div class="page-hero page-hero-sm">
  <div class="container text-center">
    <h1>Checkout</h1>
  </div>
</div>

<div class="container-fluid bg-3 checkout-section">
  <div class="container">
    <% if (errors.form) { %><div class="form-error-banner"><%= errors.form %></div><% } %>
    <form class="sky-form" method="POST" action="/checkout" id="checkout-form">
      <div class="row">
        <div class="col-sm-7">

          <div class="checkout-card">
            <h3>Customer Information</h3>
            <div class="row">
              <div class="col-sm-6">
                <div class="form-group">
                  <label for="firstName">First Name</label>
                  <input type="text" id="firstName" name="firstName" class="form-control <%= errors.firstName ? 'has-error' : '' %>" value="<%= values.firstName || '' %>" required>
                  <% if (errors.firstName) { %><span class="field-error"><%= errors.firstName %></span><% } %>
                </div>
              </div>
              <div class="col-sm-6">
                <div class="form-group">
                  <label for="lastName">Last Name</label>
                  <input type="text" id="lastName" name="lastName" class="form-control <%= errors.lastName ? 'has-error' : '' %>" value="<%= values.lastName || '' %>" required>
                  <% if (errors.lastName) { %><span class="field-error"><%= errors.lastName %></span><% } %>
                </div>
              </div>
            </div>
            <div class="row">
              <div class="col-sm-6">
                <div class="form-group">
                  <label for="email">Email</label>
                  <input type="email" id="email" name="email" class="form-control <%= errors.email ? 'has-error' : '' %>" value="<%= values.email || '' %>" required>
                  <% if (errors.email) { %><span class="field-error"><%= errors.email %></span><% } %>
                </div>
              </div>
              <div class="col-sm-6">
                <div class="form-group">
                  <label for="phone">Phone Number</label>
                  <input type="text" id="phone" name="phone" class="form-control <%= errors.phone ? 'has-error' : '' %>" value="<%= values.phone || '' %>" required>
                  <% if (errors.phone) { %><span class="field-error"><%= errors.phone %></span><% } %>
                </div>
              </div>
            </div>
          </div>

          <div class="checkout-card">
            <h3>Shipping Address</h3>
            <% if (enabledZones.length === 0) { %>
            <div class="form-error-banner">SkyPadel isn't currently delivering to any area — please check back soon.</div>
            <% } %>
            <div class="row">
              <div class="col-sm-6">
                <div class="form-group">
                  <label for="country">Country</label>
                  <input type="text" id="country" class="form-control" value="<%= country %>" disabled>
                  <input type="hidden" name="country" value="<%= country %>">
                </div>
              </div>
              <div class="col-sm-6">
                <div class="form-group">
                  <label for="city">Governorate</label>
                  <select id="city" name="city" class="form-control <%= errors.city ? 'has-error' : '' %>" required <%= enabledZones.length === 0 ? 'disabled' : '' %>>
                    <option value="">Select a governorate</option>
                    <% enabledZones.forEach(function(zone) { %>
                    <option value="<%= zone %>" <%= values.city === zone ? 'selected' : '' %>><%= zone %></option>
                    <% }); %>
                  </select>
                  <% if (errors.city) { %><span class="field-error"><%= errors.city %></span><% } %>
                </div>
              </div>
            </div>

            <% var zoneByName = {}; zones.forEach(function (z) { zoneByName[z.name] = z; }); %>
            <div class="zone-picker">
              <p class="zone-picker-label">Or pick your governorate on the map</p>
              <svg viewBox="0 0 320 500" class="zone-map zone-map-picker" role="img" aria-label="Pick your governorate on the map of Lebanon">
                <polygon class="zone-shape zone-pick <%= zoneByName['Akkar'].enabled ? 'zone-on' : 'zone-off' %> <%= values.city === 'Akkar' ? 'zone-selected' : '' %>" data-zone-name="Akkar" data-enabled="<%= zoneByName['Akkar'].enabled %>" points="80,20 260,20 250,90 90,90"></polygon>
                <polygon class="zone-shape zone-pick <%= zoneByName['North Lebanon'].enabled ? 'zone-on' : 'zone-off' %> <%= values.city === 'North Lebanon' ? 'zone-selected' : '' %>" data-zone-name="North Lebanon" data-enabled="<%= zoneByName['North Lebanon'].enabled %>" points="90,90 190,90 185,190 75,190"></polygon>
                <polygon class="zone-shape zone-pick <%= zoneByName['Baalbek-Hermel'].enabled ? 'zone-on' : 'zone-off' %> <%= values.city === 'Baalbek-Hermel' ? 'zone-selected' : '' %>" data-zone-name="Baalbek-Hermel" data-enabled="<%= zoneByName['Baalbek-Hermel'].enabled %>" points="190,90 250,90 275,230 185,190"></polygon>
                <polygon class="zone-shape zone-pick <%= zoneByName['Mount Lebanon'].enabled ? 'zone-on' : 'zone-off' %> <%= values.city === 'Mount Lebanon' ? 'zone-selected' : '' %>" data-zone-name="Mount Lebanon" data-enabled="<%= zoneByName['Mount Lebanon'].enabled %>" points="75,190 185,190 195,340 70,335"></polygon>
                <polygon class="zone-shape zone-pick <%= zoneByName['Beqaa'].enabled ? 'zone-on' : 'zone-off' %> <%= values.city === 'Beqaa' ? 'zone-selected' : '' %>" data-zone-name="Beqaa" data-enabled="<%= zoneByName['Beqaa'].enabled %>" points="185,190 275,230 280,370 195,340"></polygon>
                <polygon class="zone-shape zone-pick <%= zoneByName['South Lebanon'].enabled ? 'zone-on' : 'zone-off' %> <%= values.city === 'South Lebanon' ? 'zone-selected' : '' %>" data-zone-name="South Lebanon" data-enabled="<%= zoneByName['South Lebanon'].enabled %>" points="70,335 195,340 185,430 75,425"></polygon>
                <polygon class="zone-shape zone-pick <%= zoneByName['Nabatieh'].enabled ? 'zone-on' : 'zone-off' %> <%= values.city === 'Nabatieh' ? 'zone-selected' : '' %>" data-zone-name="Nabatieh" data-enabled="<%= zoneByName['Nabatieh'].enabled %>" points="195,340 280,370 270,460 185,430"></polygon>

                <text x="165" y="60" class="zone-label">Akkar</text>
                <text x="128" y="145" class="zone-label">North<tspan x="128" dy="14">Lebanon</tspan></text>
                <text x="222" y="150" class="zone-label">Baalbek-<tspan x="222" dy="14">Hermel</tspan></text>
                <text x="128" y="270" class="zone-label">Mount<tspan x="128" dy="14">Lebanon</tspan></text>
                <text x="228" y="285" class="zone-label">Beqaa</text>
                <text x="118" y="385" class="zone-label">South<tspan x="118" dy="14">Lebanon</tspan></text>
                <text x="222" y="405" class="zone-label">Nabatieh</text>

                <line x1="25" y1="265" x2="58" y2="265" class="zone-leader"></line>
                <circle class="zone-shape zone-shape-circle zone-pick <%= zoneByName['Beirut'].enabled ? 'zone-on' : 'zone-off' %> <%= values.city === 'Beirut' ? 'zone-selected' : '' %>" data-zone-name="Beirut" data-enabled="<%= zoneByName['Beirut'].enabled %>" cx="65" cy="265" r="9"></circle>
                <text x="18" y="255" class="zone-label">Beirut</text>
              </svg>
              <p class="zone-map-hint">Green = we deliver there. Gray areas aren't available yet.</p>
            </div>

            <div class="form-group">
              <label for="addressLine">Address</label>
              <input type="text" id="addressLine" name="addressLine" class="form-control <%= errors.addressLine ? 'has-error' : '' %>" value="<%= values.addressLine || '' %>" required>
              <% if (errors.addressLine) { %><span class="field-error"><%= errors.addressLine %></span><% } %>
            </div>
            <div class="row">
              <div class="col-sm-6">
                <div class="form-group">
                  <label for="apartment">Apartment / Building <span style="text-transform:none;">(optional)</span></label>
                  <input type="text" id="apartment" name="apartment" class="form-control" value="<%= values.apartment || '' %>">
                </div>
              </div>
              <div class="col-sm-6">
                <div class="form-group">
                  <label for="postalCode">Postal Code</label>
                  <input type="text" id="postalCode" name="postalCode" class="form-control <%= errors.postalCode ? 'has-error' : '' %>" value="<%= values.postalCode || '' %>" required>
                  <% if (errors.postalCode) { %><span class="field-error"><%= errors.postalCode %></span><% } %>
                </div>
              </div>
            </div>
            <label class="form-check-label"><input type="checkbox" name="saveAddress" value="1"> Save this address to my profile</label>
          </div>

          <div class="checkout-card">
            <h3>Payment</h3>
            <div class="test-mode-banner"><span class="glyphicon glyphicon-info-sign"></span>Test Mode &mdash; no real charge will be made. Use any card-shaped number.</div>
            <div class="form-group">
              <label for="cardName">Cardholder Name</label>
              <input type="text" id="cardName" name="cardName" class="form-control <%= errors.cardName ? 'has-error' : '' %>" value="<%= values.cardName || '' %>" required>
              <% if (errors.cardName) { %><span class="field-error"><%= errors.cardName %></span><% } %>
            </div>
            <div class="form-group">
              <label for="cardNumber">Card Number</label>
              <input type="text" id="cardNumber" name="cardNumber" class="form-control card-number-input <%= errors.cardNumber ? 'has-error' : '' %>" placeholder="4242 4242 4242 4242" maxlength="23" value="<%= values.cardNumber || '' %>" required>
              <% if (errors.cardNumber) { %><span class="field-error"><%= errors.cardNumber %></span><% } %>
            </div>
            <div class="row">
              <div class="col-sm-6">
                <div class="form-group">
                  <label for="expiry">Expiry (MM/YY)</label>
                  <input type="text" id="expiry" name="expiry" class="form-control <%= errors.expiry ? 'has-error' : '' %>" placeholder="MM/YY" maxlength="5" value="<%= values.expiry || '' %>" required>
                  <% if (errors.expiry) { %><span class="field-error"><%= errors.expiry %></span><% } %>
                </div>
              </div>
              <div class="col-sm-6">
                <div class="form-group">
                  <label for="cvv">CVV</label>
                  <input type="text" id="cvv" name="cvv" class="form-control <%= errors.cvv ? 'has-error' : '' %>" maxlength="4" required>
                  <% if (errors.cvv) { %><span class="field-error"><%= errors.cvv %></span><% } %>
                </div>
              </div>
            </div>
          </div>

        </div>

        <div class="col-sm-5">
          <div class="cart-summary">
            <h3>Order Summary</h3>
            <% items.forEach(function(item) { %>
            <div class="cart-summary-row">
              <span><%= item.name %> &times; <%= item.quantity %></span>
              <span>$<%= (Number(item.price) * item.quantity).toFixed(2) %></span>
            </div>
            <% }); %>
            <hr style="border-color:#eef1f2;">
            <div class="cart-summary-row"><span>Subtotal</span><span>$<%= totals.subtotal.toFixed(2) %></span></div>
            <div class="cart-summary-row discount"><span>Discount</span><span>&minus;$<%= totals.discountTotal.toFixed(2) %></span></div>
            <div class="cart-summary-row"><span>Shipping</span><span><%= totals.shippingTotal === 0 ? 'Free' : '$' + totals.shippingTotal.toFixed(2) %></span></div>
            <div class="cart-summary-total"><span>Total</span><span>$<%= totals.total.toFixed(2) %></span></div>
            <button type="submit" class="btn-sky btn-sky-yellow btn-sky-block" <%= enabledZones.length === 0 ? 'disabled' : '' %>>Place Order</button>
          </div>
        </div>
      </div>
    </form>
  </div>
</div>

<% include ../partials/footer %>
</body>
<% include ../partials/script %>
<script src="/javascripts/checkout.js"></script>
</html>
