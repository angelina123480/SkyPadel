<!DOCTYPE html>
<html lang="en">
<head>
 <% include ../partials/head %>
</head>
<body>
<% include ../partials/menu %>

<div class="page-hero page-hero-sm">
  <div class="container text-center">
    <h1>Create Your Account</h1>
    <p>Track orders, save your shipping details, and check out faster next time.</p>
  </div>
</div>

<div class="container-fluid bg-3 auth-section">
  <div class="container">
    <div class="sky-form-narrow">
      <% if (errors.form) { %><div class="form-error-banner"><%= errors.form %></div><% } %>

      <% if (googleConfigured) { %>
      <a class="btn-google" href="/auth/google">
        <svg viewBox="0 0 18 18"><path fill="#4285F4" d="M17.64 9.2c0-.64-.06-1.25-.16-1.84H9v3.48h4.84a4.14 4.14 0 0 1-1.8 2.72v2.26h2.9c1.7-1.57 2.7-3.88 2.7-6.62z"/><path fill="#34A853" d="M9 18c2.43 0 4.47-.8 5.96-2.18l-2.9-2.26c-.8.54-1.84.86-3.06.86-2.35 0-4.34-1.59-5.05-3.72H.98v2.33A9 9 0 0 0 9 18z"/><path fill="#FBBC05" d="M3.95 10.7A5.4 5.4 0 0 1 3.68 9c0-.59.1-1.17.27-1.7V4.97H.98A9 9 0 0 0 0 9c0 1.45.35 2.83.98 4.03l2.97-2.33z"/><path fill="#EA4335" d="M9 3.58c1.32 0 2.51.46 3.44 1.35l2.58-2.58C13.46.89 11.43 0 9 0A9 9 0 0 0 .98 4.97l2.97 2.33C4.66 5.17 6.65 3.58 9 3.58z"/></svg>
        Continue with Google
      </a>
      <div class="auth-divider">or create an account with email</div>
      <% } %>

      <form class="sky-form" method="POST" action="/register">
        <div class="row">
          <div class="col-sm-6">
            <div class="form-group">
              <label for="firstName">First Name</label>
              <input type="text" id="firstName" name="firstName" class="form-control <%= errors.firstName ? 'has-error' : '' %>" value="<%= values.firstName || '' %>" required>
              <% if (errors.firstName) { %><span class="field-error"><%= errors.firstName %></span><% } %>
            </div>
          </div>
          <div class="col-sm-6">
            <div class="form-group">
              <label for="lastName">Last Name</label>
              <input type="text" id="lastName" name="lastName" class="form-control <%= errors.lastName ? 'has-error' : '' %>" value="<%= values.lastName || '' %>" required>
              <% if (errors.lastName) { %><span class="field-error"><%= errors.lastName %></span><% } %>
            </div>
          </div>
        </div>
        <div class="form-group">
          <label for="email">Email</label>
          <input type="email" id="email" name="email" class="form-control <%= errors.email ? 'has-error' : '' %>" value="<%= values.email || '' %>" required>
          <% if (errors.email) { %><span class="field-error"><%= errors.email %></span><% } %>
        </div>
        <div class="form-group">
          <label for="password">Password</label>
          <input type="password" id="password" name="password" class="form-control <%= errors.password ? 'has-error' : '' %>" required minlength="8">
          <% if (errors.password) { %><span class="field-error"><%= errors.password %></span><% } %>
        </div>
        <div class="form-group">
          <label for="confirmPassword">Confirm Password</label>
          <input type="password" id="confirmPassword" name="confirmPassword" class="form-control <%= errors.confirmPassword ? 'has-error' : '' %>" required minlength="8">
          <% if (errors.confirmPassword) { %><span class="field-error"><%= errors.confirmPassword %></span><% } %>
        </div>
        <button type="submit" class="btn-sky btn-sky-yellow btn-sky-block">Create Account</button>
      </form>
      <p class="sky-form-links">Already have an account? <a href="/login">Sign in</a></p>
    </div>
  </div>
</div>

<% include ../partials/footer %>
</body>
<% include ../partials/script %>
</html>
