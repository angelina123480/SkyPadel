<!DOCTYPE html>
<html lang="en">
<head>
 <% include ../partials/head %>
</head>
<body>
<% include ../partials/menu %>

<div class="page-hero page-hero-sm">
  <div class="container text-center">
    <h1>Reset Password</h1>
    <p>Choose a new password for your account.</p>
  </div>
</div>

<div class="container-fluid bg-3 auth-section">
  <div class="container">
    <div class="sky-form-narrow">
      <% if (invalid) { %>
        <div class="form-error-banner">This reset link is invalid or has expired.</div>
        <p class="sky-form-links"><a href="/forgot-password">Request a new link</a></p>
      <% } else { %>
        <form class="sky-form" method="POST" action="/reset-password/<%= token %>">
          <div class="form-group">
            <label for="password">New Password</label>
            <input type="password" id="password" name="password" class="form-control <%= errors.password ? 'has-error' : '' %>" required minlength="8">
            <% if (errors.password) { %><span class="field-error"><%= errors.password %></span><% } %>
          </div>
          <div class="form-group">
            <label for="confirmPassword">Confirm New Password</label>
            <input type="password" id="confirmPassword" name="confirmPassword" class="form-control <%= errors.confirmPassword ? 'has-error' : '' %>" required minlength="8">
            <% if (errors.confirmPassword) { %><span class="field-error"><%= errors.confirmPassword %></span><% } %>
          </div>
          <button type="submit" class="btn-sky btn-sky-yellow btn-sky-block">Reset Password</button>
        </form>
      <% } %>
    </div>
  </div>
</div>

<% include ../partials/footer %>
</body>
<% include ../partials/script %>
</html>
