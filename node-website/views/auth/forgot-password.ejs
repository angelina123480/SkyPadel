<!DOCTYPE html>
<html lang="en">
<head>
 <% include ../partials/head %>
</head>
<body>
<% include ../partials/menu %>

<div class="page-hero page-hero-sm">
  <div class="container text-center">
    <h1>Forgot Password</h1>
    <p>We'll send you a link to reset it.</p>
  </div>
</div>

<div class="container-fluid bg-3 auth-section">
  <div class="container">
    <div class="sky-form-narrow">
      <% if (sent) { %>
        <div class="form-success-banner">If that email has an account, a reset link is on its way.</div>
        <% if (devResetUrl) { %>
          <div class="form-error-banner">
            Email sending isn't configured yet, so here's your reset link directly (development mode only):<br>
            <a href="<%= devResetUrl %>"><%= devResetUrl %></a>
          </div>
        <% } %>
        <p class="sky-form-links"><a href="/login">Back to sign in</a></p>
      <% } else { %>
        <form class="sky-form" method="POST" action="/forgot-password">
          <div class="form-group">
            <label for="email">Email</label>
            <input type="email" id="email" name="email" class="form-control" required>
          </div>
          <button type="submit" class="btn-sky btn-sky-yellow btn-sky-block">Send Reset Link</button>
        </form>
        <p class="sky-form-links"><a href="/login">Back to sign in</a></p>
      <% } %>
    </div>
  </div>
</div>

<% include ../partials/footer %>
</body>
<% include ../partials/script %>
</html>
