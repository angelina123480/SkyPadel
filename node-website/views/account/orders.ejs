<!DOCTYPE html>
<html lang="en">
<head>
 <% include ../partials/head %>
</head>
<body>
<% include ../partials/menu %>

<div class="page-hero page-hero-sm">
  <div class="container text-center">
    <h1>My Orders</h1>
  </div>
</div>

<div class="container-fluid bg-3 account-section">
  <div class="container">
    <% if (orders.length === 0) { %>
      <div class="empty-state">
        <span class="glyphicon glyphicon-shopping-cart"></span>
        <h3>No orders yet</h3>
        <p>Once you place an order, it'll show up here with live status tracking.</p>
        <a href="/shop" class="btn-sky btn-sky-yellow">Shop Bundles</a>
      </div>
    <% } else { %>
    <div class="data-table-wrap">
      <table class="data-table">
        <thead>
          <tr><th>Order</th><th>Date</th><th class="numeric">Total</th><th>Status</th><th></th></tr>
        </thead>
        <tbody>
          <% orders.forEach(function(o) { %>
          <tr>
            <td><%= o.order_number %></td>
            <td><%= new Date(o.created_at).toLocaleDateString() %></td>
            <td class="numeric">$<%= Number(o.total).toFixed(2) %></td>
            <td><span class="status-badge status-<%= o.status %>"><%= o.status %></span></td>
            <td><a href="/orders/<%= o.id %>" class="btn-sky btn-sky-outline-dark btn-sky-sm">View</a></td>
          </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
    <% } %>
  </div>
</div>

<% include ../partials/footer %>
</body>
<% include ../partials/script %>
</html>
