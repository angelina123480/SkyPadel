<footer class="site-footer">
  <div class="container">
    <div class="row">
      <div class="col-sm-4 footer-col">
        <h4>
          <% if (typeof logoUrl !== 'undefined' && logoUrl) { %>
          <img src="<%= logoUrl %>" alt="SkyPadel" class="footer-logo">
          <% } else { %>
          <span class="brand-ball brand-ball-sm"></span>SkyPadel
          <% } %>
        </h4>
        <p>One brand. Every bundle. Premium padel and tennis balls trusted for consistent bounce, on every surface, every match.</p>
      </div>
      <div class="col-sm-4 footer-col">
        <h4>Quick Links</h4>
        <ul class="footer-links">
          <li><a href="/">Home</a></li>
          <li><a href="/shop">Shop Bundles</a></li>
          <li><a href="/news">News</a></li>
          <li><a href="/about">About Us</a></li>
          <li><a href="/contact">Contact Us</a></li>
        </ul>
      </div>
      <div class="col-sm-4 footer-col">
        <h4>Stay In The Loop</h4>
        <p>Get bundle drops and club pricing in your inbox.</p>
        <form class="newsletter-form" onsubmit="return false;">
          <input type="email" class="newsletter-input" placeholder="Your email address" aria-label="Email address">
          <button type="submit" class="btn-sky btn-sky-yellow newsletter-btn">Join</button>
        </form>
        <div class="social-row">
          <a href="#" aria-label="Instagram"><span class="glyphicon glyphicon-camera"></span></a>
          <a href="#" aria-label="Facebook"><span class="glyphicon glyphicon-thumbs-up"></span></a>
          <a href="#" aria-label="Email"><span class="glyphicon glyphicon-envelope"></span></a>
        </div>
      </div>
    </div>
    <hr class="footer-divider">
    <p class="footer-bottom">&copy; <span id="footer-year"></span> SkyPadel. All rights reserved.</p>
  </div>
</footer>