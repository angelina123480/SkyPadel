<!DOCTYPE html>
<html lang="en">
<head>
 <% include partials/head %>
</head>
<body>
<% include partials/menu %>

<div class="page-hero page-hero-sm">
  <div class="container text-center">
    <h1>Shop SkyPadel Balls</h1>
    <p>One brand. Every bundle size. Choose padel or tennis, then pick the pack that fits how often you play.</p>
  </div>
</div>

<div class="container-fluid bg-3 shop-section">
  <div class="container">

    <div class="shop-section-header">
      <h2><span class="ball-graphic ball-padel ball-graphic-inline"></span>Padel Balls</h2>
      <p>Consistent bounce and control, tuned for indoor and outdoor courts.</p>
    </div>
    <div class="row bundle-row">
      <% padelBundles.forEach(function(b) { %>
      <div class="col-sm-4">
        <div class="bundle-card <%= b.tag ? 'bundle-card-featured' : '' %>">
          <% if (b.tag) { %><span class="bundle-tag"><%= b.tag %></span><% } %>
          <div class="ball-graphic ball-padel"></div>
          <h3><%= b.name %></h3>
          <p class="bundle-unit"><%- b.unitLabel %></p>
          <p class="bundle-blurb"><%= b.blurb %></p>
          <div class="bundle-price">
            $<%= b.price.toFixed(2) %>
            <span class="bundle-price-per">$<%= (b.price / b.balls).toFixed(2) %> / ball</span>
          </div>
          <button type="button" class="btn-sky btn-sky-block add-to-cart" data-bundle="Padel <%= b.name %>">Add to Cart</button>
        </div>
      </div>
      <% }); %>
    </div>

    <div class="shop-section-header shop-section-header-spaced">
      <h2><span class="ball-graphic ball-tennis ball-graphic-inline"></span>Tennis Balls</h2>
      <p>Durable felt and reliable pressure, from a quick rally to full club play.</p>
    </div>
    <div class="row bundle-row">
      <% tennisBundles.forEach(function(b) { %>
      <div class="col-sm-4">
        <div class="bundle-card <%= b.tag ? 'bundle-card-featured' : '' %>">
          <% if (b.tag) { %><span class="bundle-tag"><%= b.tag %></span><% } %>
          <div class="ball-graphic ball-tennis"></div>
          <h3><%= b.name %></h3>
          <p class="bundle-unit"><%- b.unitLabel %></p>
          <p class="bundle-blurb"><%= b.blurb %></p>
          <div class="bundle-price">
            $<%= b.price.toFixed(2) %>
            <span class="bundle-price-per">$<%= (b.price / b.balls).toFixed(2) %> / ball</span>
          </div>
          <button type="button" class="btn-sky btn-sky-block add-to-cart" data-bundle="Tennis <%= b.name %>">Add to Cart</button>
        </div>
      </div>
      <% }); %>
    </div>

    <div class="shop-note">
      <span class="glyphicon glyphicon-info-sign"></span>
      Cart shown above is a preview only &mdash; checkout and payment are coming soon.
    </div>

  </div>
</div>

<% include partials/footer %>
</body>
<% include partials/script %>
</html>
