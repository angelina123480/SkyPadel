<!DOCTYPE html>
<html lang="en">
<head>
 <% include ../partials/head %>
</head>
<body>
<% include ../partials/menu %>

<div class="page-hero page-hero-sm">
  <div class="container text-center">
    <h1>Manage Admins</h1>
    <p>Invite teammates to help run SkyPadel.</p>
  </div>
</div>

<div class="container-fluid bg-3 admin-section">
  <div class="container">

    <% if (invited) { %>
    <div class="admin-banner admin-banner-success">Invitation sent.</div>
    <% } %>
    <% if (removed) { %>
    <div class="admin-banner admin-banner-success">Admin access removed.</div>
    <% } %>
    <% if (error) { %>
    <div class="admin-banner admin-banner-error"><%= error %></div>
    <% } %>

    <div class="row">
      <div class="col-sm-5">
        <h3>Invite a New Admin</h3>
        <form action="/admin/admins/invite" method="post" class="admin-invite-form">
          <div class="form-group">
            <label for="email">Email address</label>
            <input type="email" class="form-control" id="email" name="email" placeholder="teammate@example.com" required>
          </div>
          <button type="submit" class="btn-sky btn-sky-yellow">Send Invite</button>
        </form>
      </div>

      <div class="col-sm-7">
        <h3>Current Admins</h3>
        <ul class="admin-list">
          <% admins.forEach(function(admin) { %>
          <li class="admin-list-item">
            <div>
              <strong><%= admin.email %></strong>
              <% if (admin.id === currentUser.id) { %><span class="admin-you-tag">You</span><% } %>
            </div>
            <% if (admin.id !== currentUser.id) { %>
            <form action="/admin/admins/<%= admin.id %>/remove" method="post" onsubmit="return confirm('Remove admin access for <%= admin.email %>?');">
              <button type="submit" class="btn-sky btn-sky-outline-dark btn-sky-sm">Remove</button>
            </form>
            <% } %>
          </li>
          <% }); %>
        </ul>
      </div>
    </div>

    <a href="/admin" class="btn-sky btn-sky-outline-dark admin-back-link">
      <span class="glyphicon glyphicon-chevron-left"></span> Back to Dashboard
    </a>

  </div>
</div>

<% include ../partials/footer %>
</body>
<% include ../partials/script %>
</html>
