# Copy this file to .env and fill in your project details.

# --- Database (PostgreSQL) ---
# Free tier options: https://neon.tech, https://supabase.com, https://railway.app
# Format: postgres://user:password@host:5432/database?sslmode=require
DATABASE_URL=

# --- Sessions ---
# Any long random string — used to sign the session cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# --- Sign in with Google (optional) ---
# From https://console.cloud.google.com — APIs & Services → Credentials → OAuth client ID.
# Authorized redirect URI must be <your-site-url>/auth/google/callback.
# Without these set, the "Continue with Google" button is hidden and email/password still works.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Admin bootstrap ---
# Comma-separated emails that get auto-promoted to admin the moment they register/sign in.
# This is how you create your first admin — every admin after that is promoted from
# inside /admin/customers, no env var editing needed.
ADMIN_EMAILS=

# --- Product image uploads (Vercel Blob) ---
# Required for the admin "add/edit product" image upload to work (both locally and
# in production — there is no local-disk fallback, since serverless filesystems are
# read-only/ephemeral). Add the "Blob" storage integration to your Vercel project
# (Storage tab) and it provisions this automatically; copy the same value here for
# local development.
BLOB_READ_WRITE_TOKEN=

# --- Sanity (SkyPadel Updates / news) ---
# Find/create these at https://www.sanity.io/manage after running `sanity login`.
SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_API_VERSION=2025-01-01

# --- Outgoing email (optional — password reset) ---
# Without these set, password reset links are shown on-screen / logged to the
# console instead of emailed, so the flow still works during local development.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=SkyPadel <no-reply@skypadel.example>
