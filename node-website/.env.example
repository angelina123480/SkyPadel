# Copy this file to .env and fill in your project details.

# --- Sanity (SkyPadel Updates / news) ---
# Find/create these at https://www.sanity.io/manage after running `sanity login`.
SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_API_VERSION=2025-01-01

# --- Accounts / admin dashboard (Clerk) ---
# Find these in your Clerk dashboard at https://dashboard.clerk.com under "API Keys".
# Also enable Google as a sign-in option somewhere in the user/authentication settings
# of that same dashboard (exact menu wording may vary by Clerk version).
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
# Comma-separated emails that get auto-promoted to admin the moment they sign in.
# This is how you create your first admin — invite everyone else from inside the dashboard.
ADMIN_EMAILS=

# --- Database (MongoDB) — bundles, orders ---
# Free tier at https://www.mongodb.com/cloud/atlas
MONGODB_URI=
